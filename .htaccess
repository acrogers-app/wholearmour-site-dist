# wholearmour.org — added 2026-09-27 (Phase 1: security headers, caching, branded 404).
# HTTPS redirect itself is handled by cPanel's "Force HTTPS Redirect" (ON); nothing here changes it.
# Rollback: delete this file. Nothing else depends on it.

Options -Indexes

# Modern image types (LiteSpeed may not map these by default)
AddType image/avif .avif
AddType image/webp .webp
AddType text/calendar .ics

<IfModule mod_headers.c>
  # HSTS: 30 days. Deliberately NO includeSubDomains and NO preload. Raise to 1 year (31536000) only
  # after the live certificate reissue (due before 12 April 2027) is done and verified; preload only
  # with explicit approval. See ops/sync/README.md.
  Header always set Strict-Transport-Security "max-age=2592000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Content-Security-Policy: REPORT-ONLY while it is tested on staging (violations show in the
  # browser console; nothing is blocked). Inline <script>/<style> blocks are allowed only by SHA-256
  # hash; src/check.mjs fails the build if a page's inline code no longer matches a hash below.
  # The homepage's podcast list reads the Buzzsprout RSS feed (feeds. redirects to rss.).
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-5AmAnFObNJmZ7ovuyOna3QreDbdf0E7pGZMsGzlpYMQ='; style-src 'self' 'sha256-slsTWrip39XyJo37e129UadMhqHVP9gDMWgYwDH90Ko=' 'sha256-BPiq145LbFc2UlnvFZN0NLd2iDxP/fhBPBiAwvzeAGE=' 'sha256-lb3SrjMGKrn+fc6EF2yFffv3jyuknqGLuVQFmVydwP4=' 'sha256-Y2ZxKrU7qGVJvd2HWlJjyddOX46jyIhTYCgmjAfbsLg='; img-src 'self'; font-src 'self'; connect-src 'self' https://feeds.buzzsprout.com https://rss.buzzsprout.com; manifest-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # HTML: always revalidate so updates land immediately; static assets: long cache.
  <FilesMatch "\.(html|shtml)$">
    Header set Cache-Control "max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpe?g|png|gif|svg|ico|woff2?|css|js|ics)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>

ErrorDocument 404 /404.html
