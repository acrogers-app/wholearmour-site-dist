# wholearmour.org — added 2026-09-27 (Phase 1: security headers, caching, branded 404).
# HTTPS redirect itself is handled by cPanel's "Force HTTPS Redirect" (ON); nothing here changes it.
# Rollback: delete this file. Nothing else depends on it.

Options -Indexes

# Modern image types (LiteSpeed may not map these by default)
AddType image/avif .avif
AddType image/webp .webp
AddType text/calendar .ics

<IfModule mod_headers.c>
  # HSTS starts with a 1-day max-age. After a week of clean HTTPS, raise to 31536000 (1 year).
  Header always set Strict-Transport-Security "max-age=86400"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Content-Security-Policy is intentionally not set yet (Phase 1 note: audit external assets first).

  # HTML: always revalidate so updates land immediately; static assets: long cache.
  <FilesMatch "\.(html|shtml)$">
    Header set Cache-Control "max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpe?g|png|gif|svg|ico|woff2?|css|js|ics)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>

ErrorDocument 404 /404.html
